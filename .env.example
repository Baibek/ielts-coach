# ---- Supabase (Project Settings → API) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Only this email can sign in (your own email).
ALLOWED_EMAIL=you@example.com

# Public URL of the app (used in sign-in links). Locally: http://localhost:3000
SITE_URL=http://localhost:3000

# ---- AI (server-side only, never prefixed with NEXT_PUBLIC_) ----
GROQ_API_KEY=gsk_xxx
# Strongest free text model in your Groq console (Models page). Example:
GROQ_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3-turbo

GEMINI_API_KEY=xxx
GEMINI_MODEL=gemini-2.5-flash

# 1 = fake AI answers for local testing without keys
AI_MOCK=0
